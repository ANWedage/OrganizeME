<Window x:Class="FolderFlow.Views.RenameFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename File" Height="240" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rename Before Moving" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" x:Name="OriginalNameText" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

        <TextBox Grid.Row="2" x:Name="FileNameBox" FontSize="13" Padding="8,6"
                 BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                 Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                 KeyDown="FileNameBox_KeyDown" />

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Keep Original" Style="{StaticResource SecondaryButton}"
                    Width="110" Margin="0,0,8,0" Click="KeepOriginal_Click" />
            <Button Content="Rename" Style="{StaticResource PrimaryButton}"
                    Width="90" Click="Rename_Click" />
        </StackPanel>
    </Grid>
</Window>
